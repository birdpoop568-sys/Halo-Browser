<Window x:Class="HaloBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HaloBrowser"
        Title="Halo" Width="1280" Height="800" MinWidth="640" MinHeight="420"
        Background="{DynamicResource HaloSurface}" Foreground="{DynamicResource HaloOnSurface}" FontFamily="{StaticResource HaloFont}"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <DataTemplate DataType="{x:Type local:TabVM}">
      <Border x:Name="Root" Width="{Binding Width}" Height="38" Margin="0,0,4,0" CornerRadius="19"
              Background="Transparent" Cursor="Hand" MouseDown="Tab_MouseDown" ToolTip="{Binding Title}">
        <Grid Margin="12,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="18" Height="18" VerticalAlignment="Center">
            <TextBlock Text="&#xE774;" FontFamily="{StaticResource HaloIcons}" FontSize="13"
                       Foreground="{DynamicResource HaloOnVariant}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image Source="{Binding Favicon}" Width="16" Height="16"/>
          </Grid>
          <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="8,0" FontSize="13" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="9"
                  Content="&#xE711;" Click="CloseTab_Click" ToolTip="Close tab (Ctrl+W)"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
          <Setter TargetName="Root" Property="Background" Value="{DynamicResource HaloOutline}"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Root" Property="Background" Value="{DynamicResource HaloContainer}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <ContextMenu x:Key="MainMenu">
      <MenuItem Header="New tab" InputGestureText="Ctrl+T" Tag="newtab" Click="Menu_Item"/>
      <MenuItem Header="New window" InputGestureText="Ctrl+N" Tag="newwindow" Click="Menu_Item"/>
      <Separator/>
      <MenuItem Header="Bookmark this page" InputGestureText="Ctrl+D" Tag="bookmark" Click="Menu_Item"/>
      <MenuItem Header="Bookmarks" Tag="halo://bookmarks" Click="Menu_Item"/>
      <MenuItem Header="History" InputGestureText="Ctrl+H" Tag="halo://history" Click="Menu_Item"/>
      <MenuItem Header="Downloads" InputGestureText="Ctrl+J" Tag="halo://downloads" Click="Menu_Item"/>
      <Separator/>
      <MenuItem Header="Print" InputGestureText="Ctrl+P" Tag="print" Click="Menu_Item"/>
      <MenuItem Header="Developer tools" InputGestureText="F12" Tag="devtools" Click="Menu_Item"/>
      <MenuItem Header="Clear browsing data" InputGestureText="Ctrl+Shift+Del" Tag="halo://settings#privacy" Click="Menu_Item"/>
      <Separator/>
      <MenuItem Header="Settings" InputGestureText="Ctrl+," Tag="halo://settings" Click="Menu_Item"/>
      <MenuItem Header="Exit" Tag="exit" Click="Menu_Item"/>
    </ContextMenu>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Tab strip -->
    <Border Grid.Row="0" Background="{DynamicResource HaloSurfaceDim}" Padding="10,8,10,4">
      <StackPanel Orientation="Horizontal">
        <ItemsControl x:Name="TabStrip" Focusable="False">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <Button Style="{StaticResource IconButton}" Width="36" Height="36" Content="&#xE710;"
                Click="NewTab_Click" ToolTip="New tab (Ctrl+T)"/>
      </StackPanel>
    </Border>

    <!-- Toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource HaloSurface}" Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="Back_Click" ToolTip="Back (Alt+Left)"/>
          <Button x:Name="FwdBtn" Style="{StaticResource IconButton}" Content="&#xE72A;" Click="Forward_Click" ToolTip="Forward (Alt+Right)"/>
          <Button x:Name="ReloadBtn" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Reload_Click" ToolTip="Reload (F5)"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE80F;" Click="Home_Click" ToolTip="Home (Alt+Home)"/>
        </StackPanel>
        <Grid Grid.Column="1" Margin="8,0">
          <TextBox x:Name="Omnibox" Style="{StaticResource OmniboxStyle}" Height="42"
                   PreviewKeyDown="Omnibox_KeyDown" PreviewMouseLeftButtonDown="Omnibox_MouseDown"
                   GotKeyboardFocus="Omnibox_GotFocus" LostKeyboardFocus="Omnibox_LostFocus" TextChanged="Omnibox_TextChanged"/>
          <TextBlock x:Name="OmniHint" IsHitTestVisible="False" Margin="18,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource HaloOnVariant}" FontSize="14"/>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="StarBtn" Style="{StaticResource IconButton}" Content="&#xE734;" Click="Star_Click" ToolTip="Bookmark this page (Ctrl+D)"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE896;" Click="Downloads_Click" ToolTip="Downloads (Ctrl+J)"/>
          <Button x:Name="MenuBtn" Style="{StaticResource IconButton}" Content="&#xE712;" Click="MenuBtn_Click" ToolTip="Menu"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Loading indicator -->
    <Grid Grid.Row="2" Background="{DynamicResource HaloSurface}">
      <ProgressBar x:Name="LoadBar" IsIndeterminate="True" Height="3" BorderThickness="0" Visibility="Collapsed"
                   Foreground="{DynamicResource HaloPrimary}" Background="Transparent"/>
    </Grid>

    <!-- Bookmarks bar -->
    <Border x:Name="BookmarkBarHost" Grid.Row="3" Background="{DynamicResource HaloSurface}" Padding="10,2,10,6" Visibility="Collapsed">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="BookmarkBar" Orientation="Horizontal"/>
      </ScrollViewer>
    </Border>

    <!-- Web content -->
    <Grid x:Name="WebHost" Grid.Row="4" Background="{DynamicResource HaloSurface}"/>

    <Popup x:Name="ToastPopup" Grid.Row="4" AllowsTransparency="True" PlacementTarget="{Binding ElementName=WebHost}"
           Placement="Center" StaysOpen="True" PopupAnimation="Fade" IsHitTestVisible="False">
      <Border Margin="20" Padding="22,12" CornerRadius="100" Background="{DynamicResource HaloOnSurface}" Effect="{StaticResource HaloShadow}">
        <TextBlock x:Name="ToastText" Foreground="White" FontSize="14"/>
      </Border>
    </Popup>
  </Grid>
</Window>
