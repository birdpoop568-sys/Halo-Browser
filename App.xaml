<Application x:Class="HaloBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- Material 3 light palette (accent brushes are swapped at runtime by Theme.Apply) -->
    <SolidColorBrush x:Key="HaloPrimary" Color="#0B57D0"/>
    <SolidColorBrush x:Key="HaloContainer" Color="#D3E3FD"/>
    <SolidColorBrush x:Key="HaloOnContainer" Color="#041E49"/>
    <SolidColorBrush x:Key="HaloSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HaloSurfaceDim" Color="#F3F6FC"/>
    <SolidColorBrush x:Key="HaloOnSurface" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="HaloOnVariant" Color="#444746"/>
    <SolidColorBrush x:Key="HaloOutline" Color="#E1E3E1"/>
    <SolidColorBrush x:Key="HaloWhite" Color="#FFFFFF"/>

    <FontFamily x:Key="HaloFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="HaloIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="HaloShadow" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#1B3A6B"/>

    <!-- Shared pill button template with an M3 "state layer" that fades in on hover -->
    <ControlTemplate x:Key="HaloButtonTemplate" TargetType="Button">
      <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
        <Border x:Name="Bg" CornerRadius="100" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
        <Border x:Name="State" CornerRadius="100" Background="{DynamicResource HaloOnSurface}" Opacity="0"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="State" Storyboard.TargetProperty="Opacity" To="0.09" Duration="0:0:0.15"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="State" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.08"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Round icon button (toolbar) -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
      <Setter Property="FontFamily" Value="{StaticResource HaloIcons}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource HaloOnVariant}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template" Value="{StaticResource HaloButtonTemplate}"/>
    </Style>

    <!-- Tonal pill button (pastel container) -->
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="20,0"/>
      <Setter Property="FontFamily" Value="{StaticResource HaloFont}"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Background" Value="{DynamicResource HaloContainer}"/>
      <Setter Property="Foreground" Value="{DynamicResource HaloOnContainer}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template" Value="{StaticResource HaloButtonTemplate}"/>
    </Style>

    <!-- Filled primary pill button -->
    <Style x:Key="FilledButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Setter Property="Background" Value="{DynamicResource HaloPrimary}"/>
      <Setter Property="Foreground" Value="{DynamicResource HaloWhite}"/>
    </Style>

    <!-- Outlined pill button -->
    <Style x:Key="OutlinedButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource HaloPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HaloOutline}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Pill-shaped address / search bar -->
    <Style x:Key="OmniboxStyle" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource HaloFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource HaloOnSurface}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource HaloPrimary}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource HaloContainer}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="22" Background="{DynamicResource HaloSurfaceDim}"
                    BorderBrush="Transparent" BorderThickness="2" Padding="14,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HaloPrimary}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HaloSurface}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HaloContainer}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Expressive card -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource HaloSurface}"/>
      <Setter Property="CornerRadius" Value="28"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HaloOutline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Effect" Value="{StaticResource HaloShadow}"/>
    </Style>

    <!-- Context menu + menu items (rounded, shadowed, pastel hover) -->
    <Style TargetType="ContextMenu">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Margin="12" Padding="6" CornerRadius="20" Background="{DynamicResource HaloSurface}"
                    BorderBrush="{DynamicResource HaloOutline}" BorderThickness="1" Effect="{StaticResource HaloShadow}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="FontFamily" Value="{StaticResource HaloFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource HaloOnSurface}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd" CornerRadius="14" Padding="14,9" MinWidth="220" Background="Transparent">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0"
                           Foreground="{DynamicResource HaloOnVariant}" FontSize="12" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HaloContainer}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="12,4" Background="{DynamicResource HaloOutline}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="FontFamily" Value="{StaticResource HaloFont}"/>
      <Setter Property="Background" Value="{DynamicResource HaloOnSurface}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,5"/>
    </Style>

  </Application.Resources>
</Application>
